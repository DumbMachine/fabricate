    "data": [
      {
        "id": "val_billing",
        "name": "acme-billing",
        "privacy": "private"
      },
      {
        "id": "val_docs",
        "name": "acme-docs",
        "privacy": "public"
      },
      {
        "id": "val_webhooks",
        "name": "acme-webhooks",
        "privacy": "unlisted"
      }
    ]
  },
