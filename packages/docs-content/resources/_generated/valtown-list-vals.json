{
  "id": "valtown-list-vals",
  "title": "List seeded vals",
  "environment": {
    "label": "Acme Val Town",
    "manifest": "environments/acme-valtown.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-valtown.yaml \\\n  | fab run --environment /dev/stdin --proxy -- \\\n    curl -sS https://api.val.town/v2/vals",
