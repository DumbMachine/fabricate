{
  "id": "ga4-read",
  "title": "Run the Acme Goods purchase report",
  "environment": {
    "label": "Acme Google Analytics 4",
    "manifest": "environments/acme-ga4.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-ga4.yaml \\\n  | fab run /dev/stdin --proxy -- \\\n    curl -sS -H 'Content-Type: application/json' \\\n      -d '{\"dateRanges\":[{\"startDate\":\"2026-08-01\",\"endDate\":\"2026-08-26\"}],\"dimensions\":[{\"name\":\"transactionId\"},{\"name\":\"sessionSource\"},{\"name\":\"sessionMedium\"},{\"name\":\"sessionCampaignName\"},{\"name\":\"eventName\"}],\"metrics\":[{\"name\":\"eventCount\"}]}' \\\n      https://analyticsdata.googleapis.com/v1beta/properties/309712345:runReport",
