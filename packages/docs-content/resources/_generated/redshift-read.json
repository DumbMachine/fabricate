{
  "id": "redshift-read",
  "title": "Query seeded orders",
  "environment": {
    "label": "Acme Redshift",
    "manifest": "environments/acme-redshift.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-redshift.yaml \\\n  | fab run /dev/stdin --proxy -- \\\n    curl -sS https://redshift-data.us-east-1.amazonaws.com/ \\\n      -H 'Content-Type: application/x-amz-json-1.1' \\\n      -H 'X-Amz-Target: RedshiftData.ExecuteStatement' \\\n      -d '{\"ClusterIdentifier\":\"acme-warehouse\",\"Database\":\"analytics\",\"Sql\":\"SELECT * FROM commerce.orders\"}'",
  "output": {
    "ClusterIdentifier": "acme-warehouse",
    "CreatedAt": 1791006504,
    "Database": "analytics",
    "DbUser": "acme",
    "HasResultSet": true,
    "Id": "fab-statement-08fe27db4b-000001",
    "RedshiftPid": 48001,
    "Status": "FINISHED"
  },
