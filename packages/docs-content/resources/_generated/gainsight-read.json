{
  "id": "gainsight-read",
  "title": "List seeded companies",
  "environment": {
    "label": "Acme Gainsight",
    "manifest": "environments/acme-gainsight.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-gainsight.yaml \\\n  | fab run /dev/stdin --proxy -- \\\n    curl -sS -H 'Content-Type: application/json' \\\n      -d '{\"select\":[\"Name\",\"Gsid\",\"Health__gc\",\"Status\"],\"limit\":100,\"offset\":0}' \\\n      -X POST https://acme.gainsightcloud.com/v1/data/objects/query/Company",
