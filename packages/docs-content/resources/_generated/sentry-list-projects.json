{
  "id": "sentry-list-projects",
  "title": "List seeded projects",
  "environment": {
    "label": "Acme Sentry",
    "manifest": "environments/acme-sentry.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-sentry.yaml \\\n  | fab run --environment /dev/stdin --proxy -- \\\n    curl -sS https://us.sentry.io/api/0/organizations/acme/projects/",
  "output": [
    {
      "id": "acme-api",
      "name": "acme-api",
      "platform": "go",
      "slug": "acme-api"
    },
    {
      "id": "acme-docs",
      "name": "acme-docs",
      "platform": "javascript",
      "slug": "acme-docs"
    },
    {
      "id": "acme-web",
      "name": "acme-web",
      "platform": "python",
      "slug": "acme-web"
    }
  ],
