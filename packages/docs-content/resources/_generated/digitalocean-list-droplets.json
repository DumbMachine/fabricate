{
  "id": "digitalocean-list-droplets",
  "title": "List seeded droplets",
  "environment": {
    "label": "Acme DigitalOcean",
    "manifest": "environments/acme-digitalocean.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-digitalocean.yaml \\\n  | fab run --environment /dev/stdin --proxy -- \\\n    curl -sS https://api.digitalocean.com/v2/droplets",
  "output": {
    "droplets": [
      {
        "id": "droplet_api",
        "name": "acme-api",
        "region": "nyc1",
        "size": "s-2vcpu-2gb",
        "status": "active"
      },
      {
        "id": "droplet_web",
        "name": "acme-web",
        "region": "nyc1",
        "size": "s-1vcpu-1gb",
        "status": "active"
      },
      {
        "id": "droplet_worker",
        "name": "acme-worker",
        "region": "nyc1",
        "size": "s-1vcpu-1gb",
        "status": "off"
      }
    ]
  },
