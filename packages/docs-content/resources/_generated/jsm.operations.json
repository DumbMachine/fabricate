      "operationId": "createRequestComment",
      "summary": "Create request comment."
    },
    {
      "method": "GET",
      "path": "/rest/servicedeskapi/request/{issueIdOrKey}/comment/{commentId}",
      "operationId": "getRequestCommentById",
