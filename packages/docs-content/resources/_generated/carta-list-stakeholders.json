{
  "id": "carta-list-stakeholders",
  "title": "List seeded stakeholders",
  "environment": {
    "label": "Acme's Carta",
    "manifest": "environments/acme-carta.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-carta.yaml \\\n  | fab run /dev/stdin --proxy -- \\\n    curl -sS https://api.carta.com/v1alpha1/issuers/issuer-acme/stakeholders",
  "output": {
    "stakeholders": [
      {
        "address": {
          "country": "IND"
        },
        "email": "val@acme.example",
        "entityType": "INDIVIDUAL",
        "fullName": "Val Ortega",
        "id": "stk-val",
        "issuerId": "issuer-acme",
        "relationship": "EMPLOYEE"
      },
      {
        "entityType": "CORPORATION",
        "fullName": "Harbor Capital",
        "id": "stk-harbor",
        "issuerId": "issuer-acme",
        "relationship": "INVESTOR"
      }
    ]
  },
