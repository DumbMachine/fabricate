{
  "id": "figma-list-webhooks",
  "title": "List seeded webhooks",
  "environment": {
    "label": "Acme Figma",
    "manifest": "environments/acme-figma.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-figma.yaml \\\n  | fab run --environment /dev/stdin --proxy -- \\\n    curl -sS https://api.figma.com/v1/teams/team_acme/webhooks",
  "output": {
    "webhooks": [
      {
        "endpoint": "https://acme.example/hooks/comments",
        "event_type": "FILE_COMMENT",
        "id": "wh_comments",
        "status": "ACTIVE",
        "team_id": "team_acme"
      },
      {
        "endpoint": "https://acme.example/hooks/files",
        "event_type": "FILE_UPDATE",
        "id": "wh_files",
        "status": "ACTIVE",
        "team_id": "team_acme"
      },
      {
        "endpoint": "https://acme.example/hooks/library",
        "event_type": "LIBRARY_PUBLISH",
        "id": "wh_library",
        "status": "ACTIVE",
        "team_id": "team_acme"
      }
    ]
  },
