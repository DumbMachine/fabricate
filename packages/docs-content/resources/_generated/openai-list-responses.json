{
  "id": "openai-list-responses",
  "title": "List seeded responses",
  "environment": {
    "label": "Acme OpenAI",
    "manifest": "environments/acme-openai.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-openai.yaml \\\n  | fab run /dev/stdin --proxy -- \\\n    curl -sS https://api.openai.com/v1/responses/resp_checkout",
  "output": {
    "id": "resp_checkout",
    "input": "Explain the checkout reliability incident",
    "model": "gpt-4.1",
    "object": "response",
    "output": "acme-web pay step 5xx. Flag checkout_reliability. Sentry acme-web. GitHub acme/web#1.",
    "status": "completed"
  },
