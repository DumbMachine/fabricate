{
  "id": "openai-list-responses",
  "title": "List seeded responses",
  "environment": {
    "label": "Acme OpenAI",
    "manifest": "environments/acme-openai.yaml"
  },
  "command": "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-openai.yaml \\\n  | fab run --environment /dev/stdin --proxy -- \\\n    curl -sS https://api.openai.com/v1/responses/resp_checkout",
