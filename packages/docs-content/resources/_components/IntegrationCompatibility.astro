---
type OperationStatus = "passed" | "failed" | "pending";

interface ModeResult {
  messagesAfter: number;
  messagesBefore: number;
  operations: Record<string, OperationStatus>;
  status: OperationStatus;
}

interface Compatibility {
  api: string;
  environment: { label: string; manifest: string; messages: number };
  integration: string;
  modes: Record<string, ModeResult>;
  operationLabels: Record<string, string>;
  testedAt: string;
  testedCommit: string;
  verification: {
    client: string;
    kind: "curl" | "official-sdk";
    label: string;
    title: string;
  };
}

const {compatibility} = Astro.props as {compatibility: Compatibility};
const modes = Object.entries(compatibility.modes);
const verified = modes.length > 0 && modes.every(([, result]) => result.status === "passed");
const operations = Object.entries(compatibility.operationLabels);
const testedAt = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(new Date(compatibility.testedAt));
---

<section class="compatibility" aria-label={`${compatibility.integration} compatibility`}>
  <header>
    <div>
      <p class="eyebrow">COMPATIBILITY</p>
      <h2>{compatibility.verification.title}</h2>
    </div>
    <span class:list={["status", {verified}]}><i aria-hidden="true"></i>{verified ? "Verified" : "Verification pending"}</span>
  </header>
  <dl class="facts">
    <div><dt>{compatibility.verification.label}</dt><dd>{compatibility.verification.client}</dd></div>
    <div><dt>Environment</dt><dd>{compatibility.environment.label} <span>· {compatibility.environment.messages} messages</span></dd></div>
    <div><dt>Last verified</dt><dd>{testedAt} <code>{compatibility.testedCommit.slice(0, 7)}</code></dd></div>
  </dl>

  <table>
    <caption>Tested operations</caption>
    <thead><tr><th scope="col">Operation</th>{modes.map(([mode]) => <th scope="col">{mode === "proxy" ? "Proxy" : "Direct"}</th>)}</tr></thead>
    <tbody>
      {operations.map(([key, label]) => (
        <tr>
          <th scope="row">{label}</th>
          {modes.map(([, result]) => <td class:list={["operation-status", result.operations[key]]}>{result.operations[key]}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .compatibility { background: var(--fabricate-surface-raised); border: 1px solid var(--fabricate-border); border-radius: var(--fabricate-radius-lg); margin: 1.8rem 0 2.4rem; padding: 1.15rem; }
  header { align-items: center; display: flex; gap: 1rem; justify-content: space-between; margin-bottom: 1rem; }
  .eyebrow { color: var(--fabricate-text-muted); font: 600 .68rem/1 var(--fabricate-font-mono); letter-spacing: .08em; margin: 0 0 .3rem; text-transform: uppercase; }
  h2 { color: var(--fabricate-text); font: 600 1rem/1.2 var(--fabricate-font-sans); margin: 0; }
  .facts { border-block: 1px solid var(--fabricate-border); margin: 0; max-width: 42rem; }
  .facts div { align-items: baseline; border-bottom: 1px solid var(--fabricate-border); display: flex; gap: 1rem; justify-content: space-between; padding: .68rem 0; }
  .facts div:last-child { border-bottom: 0; }
  dt { color: var(--fabricate-text-muted); font: 600 .68rem/1.2 var(--fabricate-font-mono); letter-spacing: .07em; text-transform: uppercase; }
  dd { color: var(--fabricate-text); font: 500 .86rem/1.4 var(--fabricate-font-mono); margin: 0; overflow-wrap: anywhere; text-align: right; }
  dd span { color: var(--fabricate-text-muted); }
  code { color: var(--fabricate-text-muted); font: inherit; margin-left: .35rem; }
  .status { align-items: center; display: inline-flex; gap: .42rem; }
  .status i { background: var(--fabricate-text-muted); border-radius: 50%; height: .42rem; width: .42rem; }
  .status.verified { color: #55d99e; }
  .status.verified i { background: #33c482; box-shadow: 0 0 .6rem #33c482; }
  table { border-collapse: collapse; color: var(--fabricate-text); font-size: .85rem; margin: 1.25rem 0 0; width: 100%; }
  caption { caption-side: top; font: 600 .84rem/1.2 var(--fabricate-font-sans); padding: 0 0 .7rem; text-align: left; }
  th, td { border-bottom: 1px solid var(--fabricate-border); padding: .68rem .25rem; text-align: left; }
  thead th { color: var(--fabricate-text-muted); font: 600 .68rem/1 var(--fabricate-font-mono); letter-spacing: .07em; text-transform: uppercase; }
  tbody th { font-weight: 500; }
  .operation-status { color: var(--fabricate-text-muted); font: 600 .68rem/1 var(--fabricate-font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .operation-status.passed { color: #55d99e; }
  @media (max-width: 32rem) { .facts div { gap: .45rem; } th, td { padding-inline: .15rem; } }
</style>
