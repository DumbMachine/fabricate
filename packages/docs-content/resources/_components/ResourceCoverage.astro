---
import {formatCountLabel, loadResourceCoverage} from "./generated";

interface Props {
  planned?: boolean;
  resource?: string;
}

const {planned = false, resource} = Astro.props as Props;
const coverage = planned ? null : loadResourceCoverage(resource);
const badges = coverage
  ? [
      formatCountLabel(coverage.scenarios, "scenario", "scenarios"),
      formatCountLabel(coverage.endpoints, "endpoint", "endpoints"),
    ]
  : planned
    ? ["Planned"]
    : [];
---

{badges.length > 0 ? (
  <p class="resource-coverage not-prose" aria-label="Coverage">
    {badges.map((label) => (
      <span>{label}</span>
    ))}
  </p>
) : null}

<style>
  .resource-coverage {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin: .15rem 0 1.35rem;
  }
  span {
    background: var(--fabricate-surface-raised);
    border: 1px solid var(--fabricate-border);
    border-radius: 999px;
    color: var(--fabricate-text-secondary);
    font: 600 .68rem/1 var(--fabricate-font-mono);
    letter-spacing: .05em;
    padding: .32rem .58rem;
    text-transform: uppercase;
  }
</style>
