{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabricate.dev/schemas/resources/ironclad/scenario-v1.json",
  "title": "Fabricate Ironclad scenario state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["currentUser", "workflows", "records", "comments", "approvals"],
  "properties": {
    "currentUser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "email", "title", "companyName"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email"},
        "title": {"type": "string", "minLength": 1},
        "companyName": {"type": "string", "minLength": 1}
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ironcladId", "title", "template", "step", "status", "isCancelled", "isComplete", "counterpartyName", "recordIds", "roleId", "roleDisplayName", "assigneeId", "created", "lastUpdated", "creatorId"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ironcladId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "template": {"type": "string", "minLength": 1},
          "step": {"type": "string", "enum": ["Review", "Sign", "Archive", "Complete"]},
          "status": {"type": "string", "enum": ["active", "paused", "completed", "cancelled"]},
          "isCancelled": {"type": "boolean"},
          "isComplete": {"type": "boolean"},
          "counterpartyName": {"type": "string", "minLength": 1},
          "counterpartyEmail": {"type": "string"},
          "docusignEnvelopeId": {"type": "string"},
          "filename": {"type": "string"},
          "recordIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "roleId": {"type": "string", "minLength": 1},
          "roleDisplayName": {"type": "string", "minLength": 1},
          "assigneeId": {"type": "string", "minLength": 1},
          "created": {"type": "string", "minLength": 1},
          "lastUpdated": {"type": "string", "minLength": 1},
          "creatorId": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ironcladId", "type", "name", "lastUpdated", "counterpartyName", "workflowId", "contractStatus", "enhancedStatus"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ironcladId": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "lastUpdated": {"type": "string", "minLength": 1},
          "counterpartyName": {"type": "string", "minLength": 1},
          "docusignEnvelopeId": {"type": "string"},
          "filename": {"type": "string"},
          "workflowId": {"type": "string", "minLength": 1},
          "contractStatus": {"type": "string", "enum": ["active", "inactive", "indeterminate"]},
          "enhancedStatus": {"type": "string", "minLength": 1}
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflowId", "commentMessage", "timestamp", "authorId"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "workflowId": {"type": "string", "minLength": 1},
          "commentMessage": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "minLength": 1},
          "authorId": {"type": "string", "minLength": 1},
          "repliedTo": {"type": "string"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflowId", "approvalGroups"],
        "properties": {
          "workflowId": {"type": "string", "minLength": 1},
          "approvalGroups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "displayName", "reviewerType", "reviewerStatus", "status", "order"],
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "displayName": {"type": "string", "minLength": 1},
                "reviewerType": {"type": "string", "minLength": 1},
                "reviewerStatus": {"type": "string", "enum": ["pending", "approved"]},
                "status": {"type": "string", "enum": ["pending", "approved", "active"]},
                "order": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
