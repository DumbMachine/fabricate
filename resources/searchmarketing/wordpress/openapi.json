            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/wp-json/wp/v2/posts/{id}": {
      "get": {
        "operationId": "posts.get",
        "responses": {
          "200": {
            "description": "OK",
