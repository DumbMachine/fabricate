{
  "openapi": "3.0.3",
  "info": {
    "title": "Search Console bounded sandbox",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://www.googleapis.com"
    }
  ],
  "paths": {
    "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query": {
      "post": {
        "operationId": "searchanalytics.query",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "startDate",
                  "endDate",
                  "dimensions"
                ],
                "properties": {
                  "startDate": {
                    "type": "string"
                  },
                  "endDate": {
                    "type": "string"
                  },
                  "dimensions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "page",
                        "query"
                      ]
                    }
                  },
                  "rowLimit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25000
                  },
                  "dimensionFilterGroups": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "siteUrl",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-access-readonly": true
      }
    }
  }
}
