{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabricate.dev/schemas/resources/vanta/scenario-v1.json",
  "title": "Fabricate Vanta scenario state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vendors", "securityReviews", "tests", "entities", "documents", "uploads"],
  "properties": {
    "vendors": {"type": "array", "items": {"$ref": "#/$defs/vendor"}},
    "securityReviews": {"type": "array", "items": {"$ref": "#/$defs/securityReview"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "uploads": {"type": "array", "items": {"$ref": "#/$defs/upload"}}
  },
  "$defs": {
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "websiteUrl", "servicesProvided", "additionalNotes", "status",
        "inherentRiskLevel", "residualRiskLevel", "latestDecision", "category",
        "securityOwnerUserId", "businessOwnerUserId", "nextSecurityReviewDueDate",
        "lastSecurityReviewCompletionDate", "vendorHeadquarters", "isVisibleToAuditors"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "websiteUrl": {"type": ["string", "null"]},
        "servicesProvided": {"type": ["string", "null"]},
        "additionalNotes": {"type": ["string", "null"]},
        "status": {"enum": ["MANAGED", "ARCHIVED", "IN_PROCUREMENT"]},
        "inherentRiskLevel": {"enum": ["CRITICAL", "HIGH", "LOW", "MEDIUM", "UNSCORED"]},
        "residualRiskLevel": {"enum": ["CRITICAL", "HIGH", "LOW", "MEDIUM", "UNSCORED"]},
        "latestDecision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]},
        "category": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/vendorCategory"}]},
        "securityOwnerUserId": {"type": ["string", "null"]},
        "businessOwnerUserId": {"type": ["string", "null"]},
        "nextSecurityReviewDueDate": {"type": ["string", "null"]},
        "lastSecurityReviewCompletionDate": {"type": ["string", "null"]},
        "vendorHeadquarters": {"type": ["string", "null"]},
        "isVisibleToAuditors": {"type": ["boolean", "null"]}
      }
    },
    "vendorCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {"displayName": {"type": "string", "minLength": 1}}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "lastUpdatedAt"],
      "properties": {
        "status": {"enum": ["APPROVED", "CONDITIONALLY_APPROVED", "NOT_APPROVED"]},
        "lastUpdatedAt": {"type": "string", "minLength": 1}
      }
    },
    "ownerActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "displayName", "email"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["USER", "TEAM"]},
        "displayName": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]}
      }
    },
    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "vendorId", "decisionNotes", "comments", "completedByUserId",
        "startDate", "dueDate", "completionDate", "decision", "owner"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "vendorId": {"type": "string", "minLength": 1},
        "decisionNotes": {"type": ["string", "null"]},
        "comments": {"type": ["string", "null"]},
        "completedByUserId": {"type": ["string", "null"]},
        "startDate": {"type": ["string", "null"]},
        "dueDate": {"type": ["string", "null"]},
        "completionDate": {"type": ["string", "null"]},
        "decision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]},
        "owner": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ownerActor"}]}
      }
    },
    "testOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "emailAddress"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "emailAddress": {"type": "string", "minLength": 1}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "lastTestRunDate", "latestFlipDate", "description",
        "failureDescription", "remediationDescription", "version", "category",
        "integrations", "status", "deactivatedStatusInfo", "remediationStatusInfo", "owner"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "lastTestRunDate": {"type": "string", "minLength": 1},
        "latestFlipDate": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "failureDescription": {"type": "string"},
        "remediationDescription": {"type": "string"},
        "version": {"$ref": "#/$defs/version"},
        "category": {"$ref": "#/$defs/category"},
        "integrations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["OK", "DEACTIVATED", "NEEDS_ATTENTION", "IN_PROGRESS", "INVALID", "NOT_APPLICABLE"]},
        "deactivatedStatusInfo": {"$ref": "#/$defs/deactivated"},
        "remediationStatusInfo": {"$ref": "#/$defs/remediation"},
        "owner": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/testOwner"}]}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"type": "number"},
        "minor": {"type": "number"}
      }
    },
    "category": {
      "enum": [
        "Accounts access", "Account security", "Account setup", "Computers", "Custom",
        "Data storage", "Employees", "Infrastructure", "IT", "Logging", "Monitoring alerts",
        "People", "Policies", "Risk analysis", "Software development", "CSPM alert management",
        "Vendors", "Vulnerability management"
      ]
    },
    "deactivated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isDeactivated", "deactivatedReason", "lastUpdatedDate"],
      "properties": {
        "isDeactivated": {"type": "boolean"},
        "deactivatedReason": {"type": ["string", "null"]},
        "lastUpdatedDate": {"type": ["string", "null"]}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "soonestRemediateByDate", "itemCount"],
      "properties": {
        "status": {"enum": ["DISABLED", "DUE_SOON", "INVALID", "IN_PROGRESS", "NA", "NEEDS_WORK", "OVERDUE", "PASS"]},
        "soonestRemediateByDate": {"type": ["string", "null"]},
        "itemCount": {"type": "number", "minimum": 0}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "testId", "entityStatus", "displayName", "responseType", "deactivatedReason", "lastUpdatedDate", "createdDate"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "testId": {"type": "string", "minLength": 1},
        "entityStatus": {"enum": ["FAILING", "DEACTIVATED"]},
        "displayName": {"type": "string", "minLength": 1},
        "responseType": {"type": "string", "minLength": 1},
        "deactivatedReason": {"type": ["string", "null"]},
        "lastUpdatedDate": {"type": "string", "minLength": 1},
        "createdDate": {"type": "string", "minLength": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "ownerId", "category", "description", "isSensitive", "title",
        "uploadStatus", "uploadStatusDate", "url", "timeSensitivity", "cadence", "reminderWindow"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ownerId": {"type": ["string", "null"]},
        "category": {"$ref": "#/$defs/category"},
        "description": {"type": "string"},
        "isSensitive": {"type": "boolean"},
        "title": {"type": "string", "minLength": 1},
        "uploadStatus": {"enum": ["Needs document", "Needs update", "Not relevant", "OK"]},
        "uploadStatusDate": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "timeSensitivity": {"enum": ["MOST_RECENT", "DURING_AUDIT_WINDOW"]},
        "cadence": {"enum": ["P0D", "P1D", "P1W", "P1M", "P3M", "P6M", "P1Y", "P2Y"]},
        "reminderWindow": {"enum": ["P0D", "P1D", "P1W", "P1M", "P3M"]}
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "documentId", "fileName", "title", "description", "mimeType", "uploadedBy",
        "creationDate", "updatedDate", "deletionDate", "effectiveDate", "url"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "documentId": {"type": "string", "minLength": 1},
        "fileName": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "mimeType": {"type": "string", "minLength": 1},
        "uploadedBy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/uploadedBy"}]},
        "creationDate": {"type": "string", "minLength": 1},
        "updatedDate": {"type": "string", "minLength": 1},
        "deletionDate": {"type": ["string", "null"]},
        "effectiveDate": {"type": ["string", "null"]},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "uploadedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["USER", "APPLICATION"]}
      }
    }
  }
}
