{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabricate.dev/schemas/resources/asana/scenario-v1.json",
  "title": "Fabricate Asana scenario state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["currentUserGid", "workspaces", "users", "projects", "sections", "tasks", "stories"],
  "properties": {
    "currentUserGid": {"type": "string", "minLength": 1},
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "name"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "isOrganization": {"type": "boolean"}
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "name", "email"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "email": {"type": "string", "format": "email"}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "workspaceGid", "name"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "workspaceGid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "archived": {"type": "boolean"}
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "projectGid", "name"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "projectGid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 0}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "workspaceGid", "name", "projectGids"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "workspaceGid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "notes": {"type": "string"},
          "completed": {"type": "boolean"},
          "assigneeGid": {"type": "string"},
          "dueOn": {"type": "string"},
          "sectionGid": {"type": "string"},
          "projectGids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "createdAt": {"type": "string"},
          "modifiedAt": {"type": "string"}
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "taskGid", "text", "createdBy"],
        "properties": {
          "gid": {"type": "string", "minLength": 1},
          "taskGid": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "createdBy": {"type": "string", "minLength": 1},
          "createdAt": {"type": "string"},
          "resourceSubtype": {"type": "string"}
        }
      }
    }
  }
}
