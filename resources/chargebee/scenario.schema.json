{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabricate.dev/schemas/resources/chargebee/scenario-v1.json",
  "title": "Fabricate Chargebee scenario state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["customers", "subscriptions", "invoices", "transactions", "comments"],
  "properties": {
    "customers": {
      "type": "array",
      "items": {"$ref": "#/$defs/customer"}
    },
    "subscriptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/subscription"}
    },
    "invoices": {
      "type": "array",
      "items": {"$ref": "#/$defs/invoice"}
    },
    "transactions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transaction"}
    },
    "comments": {
      "type": "array",
      "items": {"$ref": "#/$defs/comment"}
    }
  },
  "$defs": {
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "first_name", "last_name", "email", "phone", "company", "auto_collection",
        "net_term_days", "allow_direct_debit", "created_at", "taxability", "updated_at",
        "pii_cleared", "resource_version", "deleted", "preferred_currency_code",
        "promotional_credits", "refundable_credits", "excess_payments", "unbilled_charges"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "first_name": {"type": "string", "minLength": 1},
        "last_name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email"},
        "phone": {"type": "string", "minLength": 1},
        "company": {"type": "string", "minLength": 1},
        "auto_collection": {"enum": ["on", "off"]},
        "net_term_days": {"type": "integer", "minimum": 0},
        "allow_direct_debit": {"type": "boolean"},
        "created_at": {"type": "integer", "minimum": 0},
        "taxability": {"enum": ["taxable", "exempt"]},
        "updated_at": {"type": "integer", "minimum": 0},
        "pii_cleared": {"type": "string", "minLength": 1},
        "resource_version": {"type": "integer", "minimum": 0},
        "deleted": {"type": "boolean"},
        "preferred_currency_code": {"const": "USD"},
        "promotional_credits": {"type": "integer", "minimum": 0},
        "refundable_credits": {"type": "integer", "minimum": 0},
        "excess_payments": {"type": "integer", "minimum": 0},
        "unbilled_charges": {"type": "integer", "minimum": 0}
      }
    },
    "subscriptionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_price_id", "item_type", "quantity", "unit_price", "amount", "free_quantity", "billing_cycles"],
      "properties": {
        "item_price_id": {"type": "string", "minLength": 1},
        "item_type": {"enum": ["plan", "addon", "charge"]},
        "quantity": {"type": "integer", "minimum": 1},
        "unit_price": {"type": "integer", "minimum": 0},
        "amount": {"type": "integer", "minimum": 0},
        "free_quantity": {"type": "integer", "minimum": 0},
        "billing_cycles": {"type": "integer", "minimum": 0}
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "customer_id", "currency_code", "status", "billing_period", "billing_period_unit",
        "created_at", "started_at", "activated_at", "current_term_start", "current_term_end",
        "due_invoices_count", "total_dues", "mrr", "has_scheduled_changes",
        "has_scheduled_advance_invoices", "deleted", "decommissioned", "resource_version",
        "updated_at", "subscription_items"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "currency_code": {"const": "USD"},
        "status": {"enum": ["future", "in_trial", "active", "non_renewing", "paused", "cancelled"]},
        "billing_period": {"type": "integer", "minimum": 1},
        "billing_period_unit": {"enum": ["day", "week", "month", "year"]},
        "created_at": {"type": "integer", "minimum": 0},
        "started_at": {"type": "integer", "minimum": 0},
        "activated_at": {"type": "integer", "minimum": 0},
        "current_term_start": {"type": "integer", "minimum": 0},
        "current_term_end": {"type": "integer", "minimum": 0},
        "next_billing_at": {"type": "integer", "minimum": 0},
        "cancelled_at": {"type": "integer", "minimum": 0},
        "cancel_reason_code": {"type": "string", "minLength": 1},
        "remaining_billing_cycles": {"type": "integer", "minimum": 0},
        "due_invoices_count": {"type": "integer", "minimum": 0},
        "due_since": {"type": "integer", "minimum": 0},
        "total_dues": {"type": "integer", "minimum": 0},
        "mrr": {"type": "integer", "minimum": 0},
        "has_scheduled_changes": {"type": "boolean"},
        "has_scheduled_advance_invoices": {"type": "boolean"},
        "deleted": {"type": "boolean"},
        "decommissioned": {"type": "boolean"},
        "resource_version": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0},
        "subscription_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subscriptionItem"}
        }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "customer_id", "subscription_id", "date_from", "date_to", "description",
        "entity_id", "entity_type", "quantity", "unit_amount", "amount", "discount_amount", "tax_amount"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "subscription_id": {"type": "string", "minLength": 1},
        "date_from": {"type": "integer", "minimum": 0},
        "date_to": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {"enum": ["plan_item_price", "addon_item_price", "charge_item_price"]},
        "quantity": {"type": "integer", "minimum": 1},
        "unit_amount": {"type": "integer", "minimum": 0},
        "amount": {"type": "integer", "minimum": 0},
        "discount_amount": {"type": "integer", "minimum": 0},
        "tax_amount": {"type": "integer", "minimum": 0}
      }
    },
    "linkedPayment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txn_id", "txn_status", "txn_date", "txn_amount", "applied_amount", "applied_at"],
      "properties": {
        "txn_id": {"type": "string", "minLength": 1},
        "txn_status": {"enum": ["success", "failure", "voided", "in_progress"]},
        "txn_date": {"type": "integer", "minimum": 0},
        "txn_amount": {"type": "integer", "minimum": 0},
        "applied_amount": {"type": "integer", "minimum": 0},
        "applied_at": {"type": "integer", "minimum": 0}
      }
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "customer_id", "subscription_id", "recurring", "status", "date", "due_date",
        "net_term_days", "price_type", "currency_code", "exchange_rate", "sub_total", "tax",
        "total", "amount_paid", "amount_due", "amount_adjusted", "credits_applied",
        "write_off_amount", "amount_to_collect", "round_off_amount", "first_invoice",
        "deleted", "resource_version", "updated_at", "line_items", "linked_payments"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "subscription_id": {"type": "string", "minLength": 1},
        "recurring": {"type": "boolean"},
        "status": {"enum": ["paid", "posted", "payment_due", "not_paid", "voided", "pending"]},
        "date": {"type": "integer", "minimum": 0},
        "due_date": {"type": "integer", "minimum": 0},
        "paid_at": {"type": "integer", "minimum": 0},
        "net_term_days": {"type": "integer", "minimum": 0},
        "price_type": {"enum": ["tax_exclusive", "tax_inclusive"]},
        "currency_code": {"const": "USD"},
        "exchange_rate": {"type": "integer", "minimum": 1},
        "sub_total": {"type": "integer", "minimum": 0},
        "tax": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "amount_paid": {"type": "integer", "minimum": 0},
        "amount_due": {"type": "integer", "minimum": 0},
        "amount_adjusted": {"type": "integer", "minimum": 0},
        "credits_applied": {"type": "integer", "minimum": 0},
        "write_off_amount": {"type": "integer", "minimum": 0},
        "amount_to_collect": {"type": "integer", "minimum": 0},
        "round_off_amount": {"type": "integer"},
        "first_invoice": {"type": "boolean"},
        "deleted": {"type": "boolean"},
        "resource_version": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0},
        "line_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lineItem"}
        },
        "linked_payments": {
          "type": "array",
          "items": {"$ref": "#/$defs/linkedPayment"}
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "customer_id", "subscription_id", "invoice_id", "type", "status", "amount",
        "amount_unused", "currency_code", "date", "payment_method", "gateway", "exchange_rate",
        "deleted", "resource_version", "updated_at"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "subscription_id": {"type": "string", "minLength": 1},
        "invoice_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["payment", "refund"]},
        "status": {"enum": ["success", "failure", "voided", "in_progress"]},
        "amount": {"type": "integer", "minimum": 0},
        "amount_unused": {"type": "integer", "minimum": 0},
        "currency_code": {"const": "USD"},
        "date": {"type": "integer", "minimum": 0},
        "payment_method": {"enum": ["card", "cash", "bank_transfer", "other"]},
        "gateway": {"type": "string", "minLength": 1},
        "exchange_rate": {"type": "integer", "minimum": 1},
        "deleted": {"type": "boolean"},
        "resource_version": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0}
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type", "entity_id", "notes", "added_by", "type", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "entity_type": {"enum": ["customer", "subscription", "invoice"]},
        "entity_id": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1000},
        "added_by": {"type": "string", "minLength": 1},
        "type": {"enum": ["user", "system"]},
        "created_at": {"type": "integer", "minimum": 0}
      }
    }
  }
}
