---
import {rewritePublishedFabricateURLs} from "../../../../packages/docs-content/git-ref.ts";
import CommandCopy from "../components/CommandCopy.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {integrations} from "../../../../packages/docs-content/resources/integrations/catalog.ts";

const siteUrl =
  import.meta.env.PUBLIC_FABRICATE_SITE_URL || "https://fabricate.dmach.in";
const docsBase = import.meta.env.PUBLIC_FABRICATE_DOCS_BASE || "/docs";
// Keep copyable links absolute: an agent reading this prompt is not browsing
// the site, so `/docs` has no host to resolve against.
const docsHref =
  import.meta.env.PUBLIC_FABRICATE_DOCS_URL ||
  import.meta.env.PUBLIC_DOCS_URL ||
  `${siteUrl.replace(/\/$/, "")}${docsBase}`;
const fab = import.meta.env.PUBLIC_FABRICATE_COMMAND || "fab";
const gitRef = import.meta.env.PUBLIC_FABRICATE_GIT_REF;
const installCommand = rewritePublishedFabricateURLs(
  "curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/install.sh | sh",
  gitRef,
);
const consultHref = "https://cal.com/dumbmachine/30min";
const agentPrompt = rewritePublishedFabricateURLs(`You are setting up Fabricate in this repository.

Fabricate runs reproducible local environments with real, stateful provider data. Start with the Acme Gmail environment and keep the application's normal provider SDK behavior intact.

1. Read the Fabricate getting-started and Gmail integration docs:
   - ${docsHref}/getting-started
   - ${docsHref}/resources/integrations/gmail
2. Check whether the fab CLI is installed. If it is not, install it with:
   ${installCommand}
3. Inspect this repository's run and test commands. Propose the smallest command that wraps the relevant command with Fabricate; do not edit application code or configuration until I approve.
4. Use Fabricate's canonical Acme Gmail environment manifest. For direct service URLs, start from:
   curl -fsSL https://raw.githubusercontent.com/DumbMachine/fabricate/main/environments/acme-gmail.yaml | ${fab} run /dev/stdin -- <my command>
5. If the app must retain Gmail's normal production hostname, use --proxy. Fabricate injects proxy, CA, service URL, and short-lived token variables only into the wrapped process.
6. Fabricate runs this Gmail environment directly; no external service is required.

Report the exact command you recommend, which environment variables the wrapped app receives, and why direct URL or proxy mode is appropriate. Then wait for my approval before making changes.`, gitRef);

// The count comes from the docs catalog so it tracks what actually ships.
const serviceCount = integrations.filter((entry) => !entry.planned).length;

// Generated by `make docs-operations`: compiled operations and seeded scenarios.
const generated = import.meta.glob<{operations?: unknown[]; scenarios?: unknown[]}>(
  "../../../../packages/docs-content/resources/_generated/*.{operations,scenarios}.json",
  {eager: true, import: "default"},
);
const tally = (key: "operations" | "scenarios") =>
  Object.values(generated).reduce((sum, file) => sum + (file[key]?.length ?? 0), 0);
const operationCount = tally("operations");
const scenarioCount = tally("scenarios");
const environmentCount = Object.keys(
  import.meta.glob("../../../../environments/*.yaml", {query: "?raw", import: "default", eager: true}),
).length;
const roundDown = (n: number) =>
  n >= 1000 ? `${(Math.floor(n / 100) * 100).toLocaleString("en-US")}+` : String(n);

const showcase = [
  ["Gmail", "gmail"],
  ["Slack", "slack"],
  ["HubSpot", "hubspot"],
  ["Shopify", "shopify"],
  ["Intercom", "intercom"],
  ["Okta", "okta"],
  ["Asana", "asana"],
  ["Cloudflare", "cloudflare"],
  ["Google Drive", "googledrive"],
  ["DocuSign", "docusign"],
  ["Greenhouse", "greenhouse"],
  ["Razorpay", "razorpay"],
  ["Chargebee", "chargebee"],
  ["Pipedrive", "pipedrive"],
  ["Attio", "attio"],
  ["Outreach", "outreach"],
  ["BambooHR", "bamboohr"],
  ["Vanta", "vanta"],
  ["Zoho Books", "zoho_books"],
  ["Mailchimp", "mailchimp"],
  ["SendGrid", "sendgrid"],
  ["Resend", "resend"],
];

const pillars = [
  ["Open source", "MIT licensed. Read the code, add an API, host it yourself."],
  ["No code changes", "Your app keeps calling gmail.googleapis.com. Fabricate answers instead."],
  ["Same start, every time", "Every run begins from the exact same data, so results are comparable."],
  ["Built for agents", "Your coding agent can spin up, check, and tear down sandboxes on its own."],
];

const ownWays = [
  {
    title: "Bring your own data",
    body: "Seed sandboxes with the customers, tickets, and deals your product actually sees. Or save a sandbox you've shaped by hand as a new starting point.",
    sample: `${fab} environment snapshot acme-support-desk`,
  },
  {
    title: "Build your own worlds",
    body: "Mix any set of APIs into one environment: a support desk, a sales team, a storefront. Keep one per edge case you want to test.",
    sample: `services:\n  mail: { resource: gmail, scenario_file: ./vip-escalation.json }`,
  },
  {
    title: "Add the APIs you need",
    body: "Each API is one open-source package with its own contract and tests. Add the one you're missing and share it back.",
    sample: "resources/<your-api>/",
  },
];

const stats = [
  [String(serviceCount), "APIs ready to use"],
  [roundDown(operationCount), "API endpoints covered"],
  [String(scenarioCount), "sample datasets"],
  [String(environmentCount), "test setups, ready to run"],
];

const mcpGuideHref =
  "https://github.com/DumbMachine/fabricate/blob/main/docs/mcp.md";
const deployGuideHref =
  "https://github.com/DumbMachine/fabricate/blob/main/deploy/console/README.md";

const useCases = [
  {
    visual: "harness",
    title: "Before you ship an agent",
    description:
      "Run evals and regression checks from the same starting state every time, so a prompt change or model swap can't quietly break a workflow.",
  },
  {
    visual: "inbox",
    title: "Test your integrations",
    description:
      "Exercise every provider call your product makes. No shared test accounts, no rate limits, no leftover state from the last run.",
  },
  {
    visual: "workspace",
    title: "Give every branch a real workspace",
    description:
      "Developers and CI jobs get a seeded copy of a customer's world, instead of an empty sandbox account.",
  },
  {
    visual: "environments",
    title: "Train on deterministic worlds",
    description:
      "Every RL rollout starts from the same state, and changes persist through the episode. Clean signal, no drift.",
  },
];

const steps = [
  {
    title: "Pick a world",
    body: "Start from a ready-made environment, or describe one and let your coding agent write the scenario.",
    code: `# environments/acme-support-desk.yaml
services:
  support-mail: { resource: gmail,    scenario: gmail.acme-corp.v1 }
  inbox:        { resource: intercom, scenario: intercom.acme-inbox.v1 }
  crm:          { resource: hubspot,  scenario: hubspot.acme-pipeline.v1 }`,
  },
  {
    title: "Wrap your command",
    body: "Run your app, tests, or agent under <code>fab run</code>. With <code>--proxy</code>, the official SDKs keep calling production hostnames and Fabricate answers.",
    code: `$ ${fab} run acme-support-desk --proxy -- pytest tests/agent
  support-mail  ready  gmail.acme-corp.v1
  inbox         ready  intercom.acme-inbox.v1
  crm           ready  hubspot.acme-pipeline.v1`,
  },
  {
    title: "Inspect every call",
    body: "Each request and state change is recorded, with tokens, cookies, and secret-shaped fields redacted.",
    code: `$ ${fab} logs acme-support-desk
  POST gmail.googleapis.com/gmail/v1/users/me/messages/send  200
  PATCH api.hubapi.com/crm/v3/objects/deals/301              200`,
  },
  {
    title: "Reset and repeat",
    body: "Every run starts from the same immutable baseline. A failure today reproduces tomorrow, on any machine.",
    code: `$ ${fab} run acme-support-desk -- pytest tests/agent
  reset  3 services to their baseline
  12 passed, 1 failed  # same failure, every run`,
  },
];

const loopSteps = [
  {
    verb: "Exercise",
    title: "Run it against real state",
    body: "Point your agent, test suite, or integration at stateful copies of the APIs it calls. No test accounts, no rate limits.",
    sample: `${fab} run acme-support-desk --proxy -- pytest`,
  },
  {
    verb: "Validate",
    title: "Check what it actually did",
    body: "Read the state it left behind and every request it made: what was sent, updated, or never written.",
    sample: "GET /api/sessions/:id/state",
  },
  {
    verb: "Evaluate",
    title: "Compare runs, not vibes",
    body: "Replay the identical baseline across prompts, models, and versions, so a score moves only when behavior does.",
    sample: "same baseline · run 41 vs run 42",
  },
];

const selfHostFeatures = [
  ["One container", "Console, control API, and sandbox URLs ship as a single image you run with Docker Compose."],
  ["Sandboxes on demand", "Create, renew, and tear down sandboxes over HTTP or MCP, straight from CI or a coding agent."],
  ["Scoped projects", "Per-project quotas, default and maximum lifetimes, and revocable, expiring tokens."],
  ["Hardened by default", "Non-root, read-only root filesystem, no Linux capabilities, no Docker socket."],
];

const faqs: [string, string][] = [
  [
    "I already mock my API calls. Why do I need Fabricate?",
    "Mocks return whatever you scripted, so they can't catch an agent replying on the wrong thread. Fabricate's sandboxes remember every change, so you can check what actually happened.",
  ],
  [
    "Why not just use test accounts?",
    "Not every service offers a free test account, and the ones that do are hard to manage and share. You also can't save one and roll it back, so every run starts from wherever the last one left off.",
  ],
  [
    "Do I need to change my code?",
    "No. Every sandbox is a REST API, so you can simply point your app at the URL Fabricate gives you. Or add --proxy and your app keeps calling the real hostnames, like gmail.googleapis.com, with nothing to change.",
  ],
  [
    "Can my agent reach production by accident?",
    "Not through the APIs Fabricate covers: their real hostnames are answered locally. Other traffic, like your LLM provider, passes through unless you turn on strict mode.",
  ],
  [
    "Is my data safe?",
    "Fabricate runs on your machine, or on your own servers when you self-host. Request logs strip tokens, cookies, and secrets before anything is saved.",
  ],
  [
    "How complete is each API?",
    "Each API is tested with the provider's official client library, and the docs list every endpoint it supports. We don't claim coverage we haven't tested.",
  ],
  [
    "How complicated is the setup?",
    "Install the CLI and wrap the command you already run. Or paste our setup brief into Claude Code, Codex, or Cursor and let it do the work.",
  ],
  [
    "Can you help our team get started?",
    "Yes. Work with the founders to turn your agents' real workflows into environments, or to plan a self-hosted deployment.",
  ],
];
---

<BaseLayout>
  <Header docsHref={docsHref} consultHref={consultHref} />
  <main class="fab-sheets">
    <section class="hero grid-stage" aria-labelledby="hero-title">
      <div class="container hero-content">
        <p class="section-label">Open source · MIT · {serviceCount} APIs</p>
        <h1 id="hero-title">You build agents. <br />We fabricate <em>their world.</em></h1>
        <p class="hero-copy">
          Open-source API sandboxes for agents and integrations. Working
          copies of Gmail, Slack, HubSpot, Shopify, and {serviceCount - 4} more,
          filled with realistic data and reset to a clean slate on every run.
        </p>
        <div class="hero-actions">
          <CommandCopy command={installCommand} />
          <a
            class="button button-secondary"
            href="#get-started"
            data-press-sound>Start building</a
          >
        </div>
      </div>
      <div class="service-strip">
        <div
          class="service-belt"
          aria-label={`${serviceCount} APIs supported by Fabricate`}
        >
          <div class="service-count" aria-hidden="true">
            <strong>{serviceCount}</strong>
            <span>APIs</span>
          </div>
          <div class="service-marquee">
            <div class="service-track">
              {
                [false, true, true].map((duplicate) => (
                  <ul
                    class="service-set"
                    aria-hidden={duplicate ? "true" : undefined}
                  >
                    {showcase.map(([name, icon]) => (
                      <li class="service">
                        <img
                          class="service-icon"
                          src={`https://logos.composio.dev/api/${icon}`}
                          width="28"
                          height="28"
                          alt=""
                          loading={duplicate ? "lazy" : "eager"}
                          decoding="async"
                        />
                        {name}
                      </li>
                    ))}
                  </ul>
                ))
              }
            </div>
          </div>
        </div>
      </div>
</section>

    <section class="why band" id="why" aria-labelledby="why-title">
      <div class="container">
        <div class="why-statement">
          <p class="section-label">Why Fabricate</p>
          <h2 id="why-title">Agents got fast.<br /><em>Testing them didn't.</em></h2>
          <p class="why-problem">
            Real APIs mean shared test accounts, rate limits, and real customers
            on the other end. Mocks answer whatever you told them to, and forget
            it by the next call.
          </p>
          <p class="why-answer">
            Fabricate gives every run its own working copy of the apps your
            agent uses. So you can trust what it did, not just what it said.
          </p>
        </div>
        <ul class="why-pillars">
          {
            pillars.map(([title, body]) => (
              <li>
                <b>{title}</b>
                <span>{body}</span>
              </li>
            ))
          }
        </ul>
        <dl class="why-stats" aria-label="Fabricate, built in the open">
          {
            stats.map(([value, label]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="chapter band tint-lime" id="sandboxes" aria-labelledby="sandboxes-title">
      <div class="container">
        <div class="chapter-copy">
          <p class="section-label">API sandboxes</p>
          <h2 id="sandboxes-title">See what your agent did,<br /><em>not what it said it did.</em></h2>
          <p>
            Your agent reads inboxes, updates CRMs, and closes tickets. Fabricate
            runs working copies of those apps, filled with a realistic customer's
            data, and remembers every change. When the agent says "logged it", you
            can check.
          </p>
        </div>
        <div class="exhibit" aria-hidden="true">
          <div class="exhibit-chips">
            <span class="chip is-active">Support</span><span class="chip">Sales</span><span class="chip">Billing</span>
          </div>
          <div class="panel panel-split">
            <div class="panel-side">
              <div class="panel-caption">Runs</div>
              <div class="run is-active">
                <div><b>Reply to Hannah's renewal question</b><small>acme-support-desk</small></div>
                <span class="tag tag-warn">1 gap</span><time>2m ago</time>
              </div>
              <div class="run">
                <div><b>Escalate a duplicate charge</b><small>acme-billing-ops</small></div>
                <time>18m ago</time>
              </div>
              <div class="run">
                <div><b>Log the call and move the deal</b><small>acme-go-to-market</small></div>
                <time>1h ago</time>
              </div>
            </div>
            <div class="panel-main">
              <div class="panel-tabs">
                <span class="is-active">State changes</span><span>Requests</span><span>Logs</span>
                <b class="panel-flag">Review</b>
              </div>
              <div class="panel-title">
                <b>Reply to Hannah's renewal question</b><small>4 services · ran in 41s</small>
              </div>
              <div class="change">
                <span class="tag tag-ok">Created</span><code>gmail · message 18f1</code>
                <p>Reply sent on the “Re: renewal terms” thread.</p>
              </div>
              <div class="change">
                <span class="tag tag-ok">Updated</span><code>hubspot · deal 301</code>
                <p>Stage moved from qualified to contract sent.</p>
              </div>
              <div class="change">
                <span class="tag tag-fail">Unchanged</span><code>intercom · conversation 101</code>
                <p>The agent said it logged the reply. No note was written.</p>
              </div>
              <p class="panel-foot">
                3 services read, 2 changed. Fetch this state from your tests and
                assert on what actually happened.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="chapter band tint-orange" id="replay" aria-labelledby="replay-title">
      <div class="container">
        <div class="chapter-copy">
          <p class="section-label">Repeatable runs</p>
          <h2 id="replay-title">Same world. Same bug.<br /><em>Every single run.</em></h2>
          <p>
            Flaky agent tests are usually flaky data. Every Fabricate run starts
            from the exact same records, IDs, and history, locked so nothing can
            drift. A failure you saw once is one you can replay, debug, and
            prove fixed.
          </p>
        </div>
        <div class="exhibit" aria-hidden="true">
          <div class="exhibit-chips">
            <span class="chip is-active">Scenario gmail.acme-corp.v1</span><span class="chip">Reset on every run</span>
          </div>
          <div class="panel panel-log">
            <div class="panel-tabs">
              <span class="is-active">Request log</span><span>State</span>
              <b class="panel-meta">run 3 of 3 · same result</b>
            </div>
            <ol class="log">
              <li><span class="ln">01</span><span class="verb">GET</span><span class="path">gmail.googleapis.com/gmail/v1/users/me/threads?q=renewal</span><span class="status">200</span></li>
              <li><span class="ln">02</span><span class="verb">GET</span><span class="path">gmail.googleapis.com/gmail/v1/users/me/threads/18c2</span><span class="status">200</span></li>
              <li class="is-hit"><span class="ln">03</span><span class="verb">POST</span><span class="path">gmail.googleapis.com/gmail/v1/users/me/messages/send</span><span class="status">200</span></li>
              <li class="log-detail"><span class="ln"></span><span class="verb"></span><span class="path">authorization: [redacted] · body.threadId: "18c1"</span><span class="status"></span></li>
              <li class="log-note">
                <span class="note-badge">F</span>
                <div>
                  <b>Replayed on runs 1, 2, and 3</b>
                  <small>Thread 18c1 is the March invoice thread, not Hannah's question. The baseline never drifts, so neither does the failure.</small>
                </div>
              </li>
              <li><span class="ln">04</span><span class="verb">PATCH</span><span class="path">api.hubapi.com/crm/v3/objects/deals/301</span><span class="status">200</span></li>
              <li><span class="ln">05</span><span class="verb">GET</span><span class="path">api.intercom.io/conversations/101</span><span class="status">200</span></li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="chapter band tint-grey" id="agent-loop" aria-labelledby="agent-loop-title">
      <div class="container">
        <div class="chapter-copy">
          <p class="section-label">The feedback loop</p>
          <h2 id="agent-loop-title">Give your agents and APIs<br /><em>the perfect feedback loop</em></h2>
          <p>
            A new prompt, a model swap, an integration update: each one meets
            the same world your users live in. Exercise it, validate what it
            actually changed, and evaluate it against the last run. Your coding
            agent can drive the whole loop itself, before anything touches
            production.
          </p>
          <a class="chapter-link" href={mcpGuideHref} target="_blank" rel="noreferrer">Explore the agent loop</a>
        </div>
        <ol class="loop-steps">
          {
            loopSteps.map(({ verb, title, body, sample }, index) => (
              <li class="loop-step">
                <span class="loop-step-index">{String(index + 1).padStart(2, "0")} · {verb}</span>
                <h3>{title}</h3>
                <p>{body}</p>
                <code>{sample}</code>
              </li>
            ))
          }
        </ol>
        <div class="exhibit" aria-hidden="true">
          <div class="exhibit-chips">
            <span class="chip is-active">Same baseline every iteration</span><span class="chip">Agents · integrations · CI</span>
          </div>
          <div class="panel panel-agent">
            <div class="panel-tabs">
              <span class="is-active">Claude Code</span><span>Codex</span><span>CI</span>
              <b class="panel-ok">Loop closed</b>
            </div>
            <ol class="loop">
              <li><i class="phase-exercise">exercise</i><code>sandbox_create</code><span>acme-support-desk · ready · 4 services</span></li>
              <li><i class="phase-exercise">exercise</i><code>pytest tests/agent</code><span>agent runs against stateful Gmail, HubSpot, Intercom</span></li>
              <li><i class="phase-validate">validate</i><code>sandbox_state</code><span class="is-bad">intercom · conversation 101 · no note written</span></li>
              <li><i class="phase-validate">validate</i><code>sandbox_logs</code><span class="is-bad">POST messages.send · threadId 18c1, wrong thread</span></li>
              <li><i class="phase-fix">fix</i><code>agent/reply.py</code><span>reply on the inbound thread, then log the note</span></li>
              <li><i class="phase-evaluate">evaluate</i><code>run 2 vs run 1</code><span class="is-good">same baseline · 12/13 → 13/13 passed</span></li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="how band" id="how-it-works" aria-labelledby="how-title">
      <div class="container">
        <div class="how-heading">
          <p class="section-label">How it works</p>
          <h2 id="how-title">One command.<br /><em>Zero code changes.</em></h2>
          <p>
            No SDK to adopt, no client to swap. Fabricate wraps the command you
            already run, answers the APIs it calls, and gets out of the way.
          </p>
        </div>
        <ol class="how-steps">
          {
            steps.map(({ title, body, code }, index) => (
              <li class="how-step">
                <div class="how-step-copy">
                  <span class="how-step-number">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{title}</h3>
                  <p set:html={body} />
                </div>
                <pre class="how-step-code"><code>{code}</code></pre>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="own band" id="make-it-yours" aria-labelledby="own-title">
      <div class="container">
        <div class="own-heading">
          <p class="section-label">Make it yours</p>
          <h2 id="own-title">Your data. Your worlds.<br /><em>Your sandboxes.</em></h2>
          <p>
            The sandboxes are yours to shape. Fill them with your own data, mix
            the apps you depend on, and add the APIs we don't cover yet, so you
            can test the exact situations your users run into.
          </p>
        </div>
        <ol class="own-cards">
          {
            ownWays.map(({ title, body, sample }, index) => (
              <li>
                <span class="own-index">{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
                <code>{sample}</code>
              </li>
            ))
          }
        </ol>
        <p class="own-foot">
          Or just describe the world you want and let your coding agent write
          it. <a href={`${docsHref}/getting-started`}>See how</a>
        </p>
      </div>
    </section>

    <section class="confidence band" id="use-cases" aria-labelledby="confidence-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="section-label">Use cases</p>
            <h2 id="confidence-title">Ship agents without<br /><em>crossing your fingers.</em></h2>
            <p>
              One sandbox model, from the first prompt change to the
              ten-thousandth RL rollout.
            </p>
          </div>
        </div>
        <div class="case-list">
          {
            useCases.map(({ visual, title, description }) => (
              <article class={`case-card case-${visual}`}>
                <div class="case-preview" aria-hidden="true">
                  {visual === "harness" && (
                    <div class="preview-window harness-window">
                      <div class="agent-window-head">
                        <img
                          src="https://logos.composio.dev/api/claude"
                          width="16"
                          height="16"
                          alt=""
                        />
                        <div>
                          <b>Claude Code</b>
                          <small>acme support workspace</small>
                        </div>
                        <span class="agent-run-state">Running</span>
                      </div>
                      <div class="agent-conversation">
                        <div class="agent-user-message">
                          Investigate the renewal request and prepare the
                          customer update.
                        </div>
                        <div class="agent-turn">
                          <span class="agent-avatar">✦</span>
                          <div class="agent-turn-body">
                            <p>
