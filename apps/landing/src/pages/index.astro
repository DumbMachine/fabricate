<script>
  // FAQ: animate each card's height open and closed instead of snapping.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLDetailsElement>(".faq-list details").forEach((details) => {
    const summary = details.querySelector("summary");
    const answer = details.querySelector("p");
    if (!summary || !answer) return;
    let animation: Animation | null = null;
    const timing = { duration: 320, easing: "cubic-bezier(.2, .7, .2, 1)" };

    summary.addEventListener("click", (event) => {
      if (reduceMotion.matches) return;
      event.preventDefault();
      const closing = details.open && !details.classList.contains("is-closing");
      const startHeight = details.offsetHeight;
      animation?.cancel();
      details.style.overflow = "hidden";

      if (closing) {
        details.classList.add("is-closing");
        const border = details.offsetHeight - details.clientHeight;
        const endHeight = summary.offsetHeight + border;
        animation = details.animate({ height: [`${startHeight}px`, `${endHeight}px`] }, timing);
        answer.animate({ opacity: [1, 0] }, { ...timing, duration: 180 });
      } else {
        details.classList.remove("is-closing");
        details.open = true;
        const endHeight = details.offsetHeight;
        animation = details.animate({ height: [`${startHeight}px`, `${endHeight}px`] }, timing);
        answer.animate({ opacity: [0, 1], transform: ["translateY(-4px)", "none"] }, { ...timing, delay: 60, fill: "backwards" });
      }

      // A click mid-animation cancels the old one; only the latest may clean up.
      const current = animation;
      current.onfinish = () => {
        if (animation !== current) return;
        if (closing) details.open = false;
        details.classList.remove("is-closing");
        details.style.overflow = "";
        animation = null;
      };
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-agent-dialog]",
  );
  const openDialog = document.querySelector<HTMLButtonElement>(
    "[data-open-agent-dialog]",
  );
  const closeDialog = document.querySelector<HTMLButtonElement>(
    "[data-close-agent-dialog]",
  );
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-prompt]");
  const prompt = document.querySelector<HTMLElement>("[data-agent-prompt]");
  openDialog?.addEventListener("click", () => dialog?.showModal());
  closeDialog?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  copyButton?.addEventListener("click", async () => {
    if (!prompt) return;
    await navigator.clipboard.writeText(prompt.textContent || "");
    copyButton.textContent = "Copied";
    window.setTimeout(() => {
      copyButton.textContent = "Copy prompt";
    }, 1800);
  });

  const environmentOptions =
    document.querySelectorAll<HTMLButtonElement>("[data-environment]");
  const environmentPreviews = document.querySelectorAll<HTMLElement>(
    "[data-environment-preview]",
  );
  environmentOptions.forEach((option) => {
    option.addEventListener("click", () => {
      const selection = option.dataset.environment;
      environmentOptions.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === option)),
      );
      environmentPreviews.forEach((preview) => {
        preview.hidden = preview.dataset.environmentPreview !== selection;
      });
      document
        .querySelector<HTMLElement>("[data-environment-selection]")
        ?.setAttribute("data-environment-selection", selection || "gmail");
    });
  });
</script>
