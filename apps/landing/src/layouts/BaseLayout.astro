---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fabricate - API sandboxes for your agents and integrations",
  description = "You build agents. We fabricate their world. Open-source, stateful API sandboxes for testing agents and integrations, reset to the same baseline on every run.",
} = Astro.props;
const isDevelopment = import.meta.env.PUBLIC_FABRICATE_SITE_MODE === "development";
const favicon = isDevelopment ? "/fabricate-favicon-dev.svg" : "/fabricate-favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8ff6a" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const probe = document.createElement("audio");
      const PRESS_SOUND_URL = probe.canPlayType('audio/ogg; codecs="opus"')
        ? "/sounds/keyboard-click.ogg"
        : "/sounds/keyboard-click.mp3";
      const PRESS_CONTROL = "[data-press-sound]";
      const sample = new Audio(PRESS_SOUND_URL);
      sample.preload = "auto";

      const playPressSound = () => {
        const click = new Audio(PRESS_SOUND_URL);
        click.volume = 1;
        void click.play().catch(() => {});
      };

      const isPressControl = (target: EventTarget | null) =>
        target instanceof Element && Boolean(target.closest(PRESS_CONTROL));

      document.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        if (!isPressControl(event.target)) return;
        playPressSound();
      });

      document.addEventListener("keydown", (event) => {
        if (event.repeat) return;
        if (event.key !== "Enter" && event.key !== " ") return;
        if (!isPressControl(event.target)) return;
        playPressSound();
      });
    </script>
  </body>
</html>
