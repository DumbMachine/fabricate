FAB_CONSOLE_PUBLIC_URL=http://localhost:4173
FABRICATE_PORT=4173
FAB_CONSOLE_TOKEN_PATH=./secrets/operator-token
# For the hosted profile, use your actual domain and HTTPS public URL:
# FABRICATE_DOMAIN=fabricate.example.com
# FAB_CONSOLE_PUBLIC_URL=https://fabricate.example.com

# Global capacity; project credentials also have a project-specific quota.
FAB_MAX_SANDBOXES=64

# Bound service fan-out in each new sandbox.
FAB_MAX_SERVICES_PER_SANDBOX=16
